NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/math-learning-platform
# Optional DNS resolvers for MongoDB SRV lookups when the router blocks SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECURE=false
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=1024

# Kashier hosted checkout. Test mode is the default; use live only with live credentials.
KASHIER_MODE=test
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
